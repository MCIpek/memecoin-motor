SOLANA_HTTP_URL=https://api.mainnet-beta.solana.com
SOLANA_WS_URL=wss://api.mainnet-beta.solana.com
# Pump bonding-curve programi (resmi pump-public-docs IDL adresi).
LAUNCH_PROGRAM_ID=6EF8rrecthR5Dkzon8Nwu78hRvfCKubJ14M5uBEwF6P
DATABASE_PATH=data/memecoin_motor.db
COMMITMENT=confirmed
MAX_BACKFILL_SLOTS=32
RPC_TIMEOUT_SECONDS=15
RECONNECT_MAX_SECONDS=30
TRADE_TRACK_SECONDS=600
# Ucretsiz RPC icin sinirli/asenkron creator + ilk alici analizi.
WALLET_ENRICHMENT_ENABLED=true
WALLET_EARLY_BUYER_LIMIT=3
WALLET_SIGNATURE_PAGE_SIZE=100
WALLET_MAX_SIGNATURE_PAGES=2
WALLET_RPC_INTERVAL_SECONDS=1.0
# Tamamen sanal paper test; cüzdan/private key kullanmaz.
PAPER_ENABLED=true
PAPER_NOTIONAL_LAMPORTS=100000000
PAPER_LATENCY_SECONDS=2
PAPER_SLIPPAGE_BPS=300
PAPER_BASE_FEE_LAMPORTS=5000
PAPER_PRIORITY_FEE_LAMPORTS=100000
PAPER_JITO_TIP_LAMPORTS=100000
PAPER_MAX_RESERVE_IMPACT_BPS=1000
PAPER_MAX_FILL_WAIT_SECONDS=8
# Ilk alicilar icin salt-okunur sniper/bundle kaniti zenginlestirmesi.
SNIPER_ENABLED=true
SNIPER_EARLY_BUYER_LIMIT=5
SNIPER_MAX_TRADE_AGE_SECONDS=10
SNIPER_RPC_INTERVAL_SECONDS=2.0
